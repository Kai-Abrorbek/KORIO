# 기본: 텍스트 파일은 자동 감지 + 저장소에는 LF로 통일
* text=auto eol=lf

# 바이너리 (개행 변환 금지)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.wav   binary
*.m4a   binary
*.pdf   binary
*.keystore binary

# Windows 배치파일만 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
