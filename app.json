{
  "expo": {
    "name": "KORIO",
    "slug": "korio",
    "version": "1.2.400",
    "orientation": "portrait",
    "icon": "./assets/images/korio-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
      "backgroundColor": "#6C35E8",
      "foregroundImage": "./assets/images/korio-icon.png"
    },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.kai_dev.mobile",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/korio-icon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7F77DD"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "친구를 찾기 위해 연락처에 접근합니다."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "발음을 평가하려면 마이크가 필요해요. / Talaffuzni baholash uchun mikrofon kerak. / We need the microphone to check your pronunciation. / Микрофон нужен для проверки произношения."
        }
      ],
      "expo-iap",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b47db016-16ef-4d27-842d-6f4443989131"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b47db016-16ef-4d27-842d-6f4443989131"
    }
  }
}