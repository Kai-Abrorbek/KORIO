# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# 캐릭터 원본 이미지 (번들 미포함)
.character-raw/

# 작업용 스크래치 (커밋 대상 아님)
_to_delete/
.tsconfig.*.json
tmp/

# Claude 작업용 잔여물 (device_bash 가 rm 을 못 해서 여기로 치운다)
_gitlock-trash/
apps/api/glossary-dry-run.json
apps/api/.pc2/

# 배포 비밀 (호스트에만 둔다)
deploy/.env
deploy/api.env
# 서비스 계정 키 (푸시 발송 권한 — 절대 커밋 금지)
*firebase-adminsdk*.json
*-serviceaccount*.json

# 루트에서 실수로 `expo prebuild` 를 돌리면 여기에 안드로이드 프로젝트가
# 생긴다 (진짜는 apps/mobile/android). 루트 package.json 에 expo/react 까지
# 끼워 넣으므로, 생기면 지우고 package.json 도 되돌릴 것.
/android
/ios
