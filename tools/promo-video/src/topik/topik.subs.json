{
 "n01": [
  { "t": 0.06, "text": "Kuniga oʻn soat ishlaydigan odam" },
  { "t": 2.08, "text": "TOPIKka qanday tayyorlanadi?" }
 ],
 "n02": [
  { "t": 0.08, "text": "Kitob ochishga ham, kursga borishga ham vaqti yoʻq." },
  { "t": 2.97, "text": "Javob — choʻntagida." },
  { "t": 4.57, "text": "Kun oxirida hisoblab koʻring —" },
  { "t": 6.0, "text": "hayron qolasiz." }
 ],
 "n03": [
  { "t": 0.06, "text": "Telefonida — Korio." },
  { "t": 1.63, "text": "Bosh sahifada «Yoʻnalish»," },
  { "t": 3.55, "text": "soʻng «TOPIK»." },
  { "t": 4.8, "text": "TOPIK I yoki II — tanlaydi." }
 ],
 "n04": [
  { "t": 0.05, "text": "Ertalab avtobusda —" },
  { "t": 1.34, "text": "25 daqiqa." },
  { "t": 2.66, "text": "Haqiqiy TOPIK variantlari." }
 ],
 "n05": [
  { "t": 0.05, "text": "Javobni bilmasa," },
  { "t": 1.13, "text": "ilova darhol javobni koʻrsatmaydi:" },
  { "t": 3.32, "text": "avval yechish usulini," },
  { "t": 4.69, "text": "keyin muhim ishorani beradi." },
  { "t": 6.68, "text": "Javobni oʻzi topadi." }
 ],
 "n06": [
  { "t": 0.08, "text": "Tushlikka ketayotib —" },
  { "t": 1.27, "text": "15 daqiqa." },
  { "t": 2.28, "text": "Quloqchinda —" },
  { "t": 3.23, "text": "haqiqiy TOPIK tinglash savollari." }
 ],
 "n07": [
  { "t": 0.07, "text": "Tushunmasa — yana eshitadi." },
  { "t": 2.0, "text": "Javob bergach," },
  { "t": 3.06, "text": "toʻliq matnni ochib tekshiradi." }
 ],
 "n08": [
  { "t": 0.06, "text": "Tanaffusda — 5 daqiqa." },
  { "t": 1.83, "text": "Faqat xato qilgan savollari." }
 ],
 "n09": [
  { "t": 0.05, "text": "Kechqurun — 45 daqiqa," },
  { "t": 1.89, "text": "xuddi haqiqiy imtihondagidek," },
  { "t": 3.7, "text": "vaqt bilan." }
 ],
 "n10": [
  { "t": 0.06, "text": "Oxirida esa ilova koʻrsatadi:" },
  { "t": 1.94, "text": "qaysi savol turida ball yoʻqotyapti." }
 ],
 "n11": [
  { "t": 0.05, "text": "Yozish qismi ham bor:" },
  { "t": 1.32, "text": "kataklarga yozish va namunaviy javoblar." }
 ],
 "n12": [
  { "t": 0.06, "text": "Endi hisoblang:" },
  { "t": 1.01, "text": "kuniga bir yarim soat." },
  { "t": 2.39, "text": "Bir daqiqa ham ortiqcha vaqt ajratmasdan." }
 ],
 "n13": [
  { "t": 0.06, "text": "Imtihon — 15-noyabrda." },
  { "t": 2.19, "text": "Hali kech emas." }
 ]
}
