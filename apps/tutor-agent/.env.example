# ── KORIO Voice Tutor Agent ────────────────────────────────────
#
#   앱 ──WebRTC──▶ LiveKit ──▶ [이 프로세스] ──STT → API(GPT) → ElevenLabs
#
# long-running worker 다. NestJS API 와 **다른 프로세스**로 띄운다.

# LiveKit 접속. API 와 같은 프로젝트를 가리켜야 한다
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# explicit dispatch 이름.
# ⚠️ API 의 VOICE_TUTOR_LIVEKIT_AGENT_NAME 과 글자 하나까지 같아야 한다
VOICE_TUTOR_LIVEKIT_AGENT_NAME=korio-voice-tutor
# worker 가 부를 API 주소 (https)
VOICE_TUTOR_API_URL=
# 받아쓰기(STT) / 선생님 목소리(TTS)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
