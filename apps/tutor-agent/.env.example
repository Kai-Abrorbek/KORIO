# ── KORIO Tutor Agent ──────────────────────────────────────────
#
#   앱 ──WebRTC──▶ LiveKit ──▶ [이 프로세스] ──Gemini Live──▶ gemini-3.8-live
#
# long-running worker 다. NestJS API 와 **다른 프로세스**로 띄운다.

# LiveKit 접속. API 와 같은 프로젝트를 가리켜야 한다
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# explicit dispatch 이름.
# ⚠️ API 의 LIVEKIT_TUTOR_AGENT_NAME 과 글자 하나까지 같아야 한다
LIVEKIT_TUTOR_AGENT_NAME=korio-tutor

# 🔴 Gemini 키. **이 프로세스에만** 둔다.
#    앱에도, NestJS 에도 넣지 않는다 — Gemini 에 붙는 건 Agent 뿐이다.
GOOGLE_API_KEY=

# metadata 에 모델이 안 실려 왔을 때의 마지막 보루.
# 평소에는 API 가 보낸 값을 쓴다.
GEMINI_LIVE_MODEL=gemini-3.8-live
