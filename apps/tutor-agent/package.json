{
  "name": "tutor-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/voice-tutor-agent.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx --env-file-if-exists=.env src/voice-tutor-agent.ts dev",
    "start": "node dist/voice-tutor-agent.js start",
    "test": "tsx --test src/voice-tutor-metadata.test.ts src/voice-tutor-speech.test.ts",
    "voice-tutor:dev": "tsx --env-file-if-exists=.env src/voice-tutor-agent.ts dev",
    "voice-tutor:start": "node dist/voice-tutor-agent.js start",
    "voice-tutor:test": "tsx --test src/voice-tutor-metadata.test.ts src/voice-tutor-speech.test.ts"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.0",
    "@livekit/agents-plugin-openai": "1.9.0",
    "@livekit/rtc-node": "^0.13.34",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.20.3",
    "typescript": "5.9.2"
  }
}
