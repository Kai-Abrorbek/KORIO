# ── 필수 ──
MONGODB_URI=
# 32자 이상. 없거나 짧으면 서버가 부팅을 거부한다 (예전 fallback_secret 폴백 제거됨)
JWT_SECRET=
# 소셜 로그인 콜백이 이 주소로 돌아온다. 개발 중엔 ngrok 같은 공개 주소가 필요하다
PUBLIC_API_URL=https://api.korio.app

# ── 구글 (네이티브 SDK → 서버가 id_token 검증) ──
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ── 텔레그램 (위젯 서명 방식) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── 카카오 (OAuth) ──
# 카카오 개발자 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 보안 > Client Secret (사용함으로 설정했을 때만)
KAKAO_CLIENT_SECRET=
# 콘솔에 등록할 Redirect URI: {PUBLIC_API_URL}/auth/kakao/callback

# ── 네이버 (OAuth) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 콘솔에 등록할 Callback URL: {PUBLIC_API_URL}/auth/naver/callback

# ── 보안 ──
# 브라우저에서 API 를 호출하는 오리진 목록 (쉼표 구분). 네이티브 앱은 필요 없다.
# 비워두면 브라우저발 크로스 오리진 요청이 전부 막힌다 (앱은 정상 동작).
ALLOWED_ORIGINS=
# ⚠️ 스토어 영수증 검증 없이 /subscription/subscribe 를 열어준다. 개발용만.
# 프로덕션에서 true 로 두면 로그인한 누구나 공짜로 구독을 켤 수 있다.
ALLOW_UNVERIFIED_SUBSCRIBE=false

# ── Google Play 결제 (Phase 1) ──
# Play Console 의 앱 패키지명
GOOGLE_PLAY_PACKAGE_NAME=
# 서비스 계정 키 JSON 통째로. ⚠️ 앱에는 절대 넣지 않는다 — 서버 전용
# (또는 GOOGLE_APPLICATION_CREDENTIALS 로 키 파일 경로를 준다)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── 서버 알림(RTDN → Pub/Sub push) 인증 ──
# 아래 둘 중 하나는 반드시 필요하다. 없으면 프로덕션에서 알림을 전부 거절한다.
#
# (권장) 인증된 push: Pub/Sub 구독 설정에서 서비스 계정과 audience 를 지정한다.
GOOGLE_PUBSUB_AUDIENCE=
# 그 서비스 계정 이메일. 안 넣으면 아무 구글 계정이나 이 audience 로 토큰을 만들 수 있다.
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
#
# (차선) 공유 비밀: push URL 을 .../webhook?key=<이 값> 으로 등록한다.
# URL 이 로그에 남을 수 있어 OIDC 를 쓸 수 있으면 그쪽이 낫다.
GOOGLE_PUBSUB_PUSH_SECRET=

# ── AI 튜터 (OpenAI Realtime, 음성 대화) ──
# ⚠️ 서버 전용. 앱에는 절대 넣지 않는다 — 앱에는 단명 토큰만 내려준다
OPENAI_API_KEY=
# 기본 gpt-realtime-mini (정가 모델보다 3배가량 저렴). 바꾸면 원가가 뛴다
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin

# ── AI (보리쌤 텍스트 채팅) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Azure Speech TTS ──
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
AZURE_SPEECH_ENDPOINT=
