# ── 필수 ──
MONGODB_URI=
# 32자 이상. 없거나 짧으면 서버가 부팅을 거부한다 (예전 fallback_secret 폴백 제거됨)
JWT_SECRET=
# 소셜 로그인 콜백이 이 주소로 돌아온다. 개발 중엔 ngrok 같은 공개 주소가 필요하다
PUBLIC_API_URL=https://api.korio.online

# ── 구글 (네이티브 SDK → 서버가 id_token 검증) ──
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ── 텔레그램 (위젯 서명 방식) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── 카카오 (OAuth) ──
# 카카오 개발자 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 보안 > Client Secret (사용함으로 설정했을 때만)
KAKAO_CLIENT_SECRET=
# 콘솔에 등록할 Redirect URI: {PUBLIC_API_URL}/auth/kakao/callback

# ── 네이버 (OAuth) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 콘솔에 등록할 Callback URL: {PUBLIC_API_URL}/auth/naver/callback

# ── 보안 ──
# 브라우저에서 API 를 호출하는 오리진 목록 (쉼표 구분). 네이티브 앱은 필요 없다.
# 비워두면 브라우저발 크로스 오리진 요청이 전부 막힌다 (앱은 정상 동작).
ALLOWED_ORIGINS=
# ⚠️ 스토어 영수증 검증 없이 /subscription/subscribe 를 열어준다. 개발용만.
# 프로덕션에서 true 로 두면 로그인한 누구나 공짜로 구독을 켤 수 있다.
ALLOW_UNVERIFIED_SUBSCRIBE=false

# ── Google Play 결제 (Phase 1) ──
# Play Console 의 앱 패키지명
GOOGLE_PLAY_PACKAGE_NAME=
# 서비스 계정 키 JSON 통째로. ⚠️ 앱에는 절대 넣지 않는다 — 서버 전용
# (또는 GOOGLE_APPLICATION_CREDENTIALS 로 키 파일 경로를 준다)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── 서버 알림(RTDN → Pub/Sub push) 인증 ──
# 아래 둘 중 하나는 반드시 필요하다. 없으면 프로덕션에서 알림을 전부 거절한다.
#
# (권장) 인증된 push: Pub/Sub 구독 설정에서 서비스 계정과 audience 를 지정한다.
GOOGLE_PUBSUB_AUDIENCE=
# 그 서비스 계정 이메일. 안 넣으면 아무 구글 계정이나 이 audience 로 토큰을 만들 수 있다.
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
#
# (차선) 공유 비밀: push URL 을 .../webhook?key=<이 값> 으로 등록한다.
# URL 이 로그에 남을 수 있어 OIDC 를 쓸 수 있으면 그쪽이 낫다.
GOOGLE_PUBSUB_PUSH_SECRET=

# ── AI 튜터 통화 (LiveKit) ─────────────────────────────────────
#
#   앱 ──WebRTC──▶ LiveKit ──▶ Tutor Agent ──Gemini Live──▶ gemini-3.8-live
#
# API 는 오디오를 지나보내지 않는다. 쿼터 검사 → 프롬프트 생성 →
# 참가자 토큰 발급 → Agent dispatch 까지만 한다.
#
# 셋 중 하나라도 비면 튜터 통화가 비활성이고, 서버가 뜰 때 경고를 찍는다.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
# 🔴 서버 전용 시크릿. 앱에는 절대 안 내려간다 — 앱은 방 하나짜리 참가자
#    토큰(15분)만 받는다
LIVEKIT_API_SECRET=
# explicit dispatch 이름. ⚠️ Agent 쪽(apps/tutor-agent)의 같은 이름과
#    글자 하나까지 같아야 한다. 다르면 dispatch 는 성공하는데 아무도 방에
#    안 들어온다 — 제일 진단하기 어려운 실패다.
LIVEKIT_TUTOR_AGENT_NAME=korio-tutor

# 대화 모델. 안 넣으면 gemini-3.8-live.
# 이 값은 dispatch metadata 로 Agent 에게 전달된다 — Agent 를 다시 배포하지
# 않고 모델을 갈아 끼울 수 있다.
# ⚠️ extended-thinking 변종은 쓰지 않는다. 회화에서 중요한 건 추론 깊이가
#    아니라 첫 소리가 언제 나오느냐다.
GEMINI_LIVE_MODEL=gemini-3.8-live

# ⚠️ GOOGLE_API_KEY 는 여기가 아니라 **apps/tutor-agent 환경**에만 둔다.
#    Gemini 에 붙는 건 Agent 뿐이다.

# ── AI 튜터 (OpenAI) ──
# ⚠️ Realtime 통화는 더 이상 OpenAI 로 돌지 않는다. 이 키는 아직
#    **세션 분석 / 우즈벡어 설명**(gpt-4o-mini) 에 쓰인다.
#    OPENAI_REALTIME_* 는 PHASE 7 에서 코드와 함께 지운다.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin

# ── AI (보리쌤 텍스트 채팅) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Azure Speech TTS ──
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
AZURE_SPEECH_ENDPOINT=

# ── 비밀번호 재설정 메일 (Resend) ────────────────────────────────
# 없어도 서버는 뜬다. 다만 "비밀번호 찾기" 코드가 발송되지 않고 로그에만
# 찍힌다 (부팅 로그에 경고가 나온다).
#   1) resend.com 에서 korio.online 도메인을 인증하고 (SPF/DKIM DNS 3줄)
#   2) API 키를 만들어 여기에 넣는다
# 🔴 서버 전용 시크릿이다. 앱에는 절대 넣지 않는다.
RESEND_API_KEY=
# 발신자. 인증한 도메인이어야 한다
MAIL_FROM=KORIO <no-reply@korio.online>

# ── AI 튜터 목소리 (하이브리드 전환) ───────────────────────────
# Realtime 은 이제 텍스트만 만든다. 소리는 외부 TTS 가 낸다.
# 기본은 Azure ko-KR (위 AZURE_SPEECH_* 를 그대로 쓴다) — 별도 설정 불필요.
#
# ElevenLabs 로 한국어 음질을 비교하려면 키를 넣고, 선생님 프로필
# (apps/api/src/tutor/teachers/tutor-teachers.ts) 의 tts.provider 를
# 'elevenlabs' 로, voiceId 를 그쪽 것으로 바꾼다. 튜터 로직은 안 건드린다.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
