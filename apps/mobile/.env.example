# 배포 빌드 API 주소 — 반드시 https. 비우면 개발 빌드에서만 LAN IP 로 폴백한다.
EXPO_PUBLIC_API_URL=

# apps/mobile 환경변수 예시 — 실제 값은 .env.local 에 넣어 (git 안 올라감)
# Expo 는 EXPO_PUBLIC_ 프리픽스 붙은 값만 앱 번들에 주입함

NODE_ENV=development

# 폰(실기기/에뮬)에서 로컬 API 붙을 때 쓰는 개발머신 LAN IP
# Windows: ipconfig / macOS: ipconfig getifaddr en0 로 확인
# 안 넣으면 localhost 로 폴백됨
EXPO_PUBLIC_DEV_LAN_IP=172.30.1.76

# Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Telegram 로그인 (배포 도메인)
EXPO_PUBLIC_TELEGRAM_AUTH_BASE=https://your-domain.com
