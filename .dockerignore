# 빌드 컨텍스트를 작게 — 이게 없으면 node_modules 수 GB 를 도커로 밀어 넣는다
**/node_modules
**/dist
**/.turbo
**/.expo
.git
.gitignore

# 모바일 앱은 이미지에 필요 없다 (package.json 만 Dockerfile 이 따로 가져간다)
apps/mobile/android
apps/mobile/ios
apps/mobile/assets
apps/mobile/src

# 작업용 잔여물
tmp/
_to_delete/
_gitlock-trash/
.character-raw/
*.patch
**/*.log
**/.env
**/.env.*
!**/.env.example
