# Copy to grok-promo-agent.env on the deployment host; never commit that file.
# Independent administrator filming tutor. Ordinary agent.env is not read here.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match api.env. Keep different from VOICE_TUTOR_LIVEKIT_AGENT_NAME.
GROK_PROMO_LIVEKIT_AGENT_NAME=korio-grok-promo
# Native Grok hears, reasons, and speaks. No OpenAI or ElevenLabs keys required.
XAI_API_KEY=
