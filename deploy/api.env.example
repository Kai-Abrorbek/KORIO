# deploy/api.env — API 컨테이너에 들어갈 환경변수. **절대 git 에 올리지 않는다.**
# 값은 apps/api/.env.example 을 보고 채운다. 여기 있는 건 전부 서버 전용이다.

MONGODB_URI=
JWT_SECRET=

# 이 값이 카카오·네이버 콘솔에 등록한 Redirect URI 의 앞부분이 된다
PUBLIC_API_URL=https://api.korio.online

# 브라우저에서 우리 API 를 부를 수 있는 출처. 네이티브 앱은 Origin 을 안 보내서
# 여기 없어도 된다. 관리자 웹을 붙일 때만 추가한다
ALLOWED_ORIGINS=

# 🔴 프로덕션에서는 반드시 비워 두거나 false. true 면 결제 검증 없이 구독이 열린다
ALLOW_UNVERIFIED_SUBSCRIBE=false

GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

GOOGLE_PLAY_PACKAGE_NAME=com.kai_dev.mobile
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_PUSH_SECRET=

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=

# SIGTERM 후 새 요청을 끊고 기다리는 시간(ms). Caddy 의 health_interval(3s)보다
# 넉넉해야 프록시가 "내려간다"를 인지할 시간이 생긴다.
# docker-compose 의 stop_grace_period(30s) 보다는 짧아야 한다
SHUTDOWN_DRAIN_MS=8000

# ── 푸시 알림 (Expo Push) ──────────────────────────────────────────
# 선택 사항. Expo 계정에서 "enhanced security" 를 켠 경우에만 필요하다.
# 안 켰으면 비워둬도 푸시는 나간다.
# FCM 자격증명은 서버가 아니라 EAS 에 올린다: `eas credentials` → Android →
# FCM V1 service account. 서버는 서비스 계정 JSON 을 들고 있지 않는다.
EXPO_ACCESS_TOKEN=

# ── 비밀번호 재설정 메일 (Resend) ────────────────────────────────
# 없어도 서버는 뜬다. 다만 "비밀번호 찾기" 코드가 발송되지 않고 로그에만
# 찍힌다 (부팅 로그에 경고가 나온다).
#   1) resend.com 에서 korio.online 도메인을 인증하고 (SPF/DKIM DNS 3줄)
#   2) API 키를 만들어 여기에 넣는다
# 🔴 서버 전용 시크릿이다. 앱에는 절대 넣지 않는다.
RESEND_API_KEY=
# 발신자. 인증한 도메인이어야 한다
MAIL_FROM=KORIO <no-reply@korio.online>

# ── AI 튜터 목소리 (하이브리드 전환) ───────────────────────────
# Realtime 은 이제 텍스트만 만든다. 소리는 외부 TTS 가 낸다.
# 기본은 Azure ko-KR (위 AZURE_SPEECH_* 를 그대로 쓴다) — 별도 설정 불필요.
#
# ElevenLabs 로 한국어 음질을 비교하려면 키를 넣고, 선생님 프로필
# (apps/api/src/tutor/teachers/tutor-teachers.ts) 의 tts.provider 를
# 'elevenlabs' 로, voiceId 를 그쪽 것으로 바꾼다. 튜터 로직은 안 건드린다.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
