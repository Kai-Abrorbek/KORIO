# deploy/api.env — API 컨테이너에 들어갈 환경변수. **절대 git 에 올리지 않는다.**
# 값은 apps/api/.env.example 을 보고 채운다. 여기 있는 건 전부 서버 전용이다.

MONGODB_URI=
JWT_SECRET=

# 이 값이 카카오·네이버 콘솔에 등록한 Redirect URI 의 앞부분이 된다
PUBLIC_API_URL=https://api.korio.online

# 브라우저에서 우리 API 를 부를 수 있는 출처.
#
# ⚠️ 네이티브 앱(Expo)은 Origin 을 안 보내서 여기 없어도 되지만, **브라우저에서
#    도는 우리 것은 전부 넣어야 한다** — Telegram Mini App, 어드민 패널.
#    빠뜨리면 그 앱의 POST 가 전부 막히는데, 확인이 어렵다:
#      · GET 은 Origin 을 안 보낸다 → /ready 확인은 통과
#      · curl 도 Origin 을 안 보낸다 → 손 테스트는 정상
#      · 브라우저는 same-origin 이어도 POST 에 Origin 을 붙인다 → 사람이 열 때만 터짐
#
# 콤마로 구분. 스킴까지 정확히 (https:// 포함, 끝에 / 없이)
ALLOWED_ORIGINS=https://telegram.korio.online,https://admin.korio.online

# 🔴 프로덕션에서는 반드시 비워 두거나 false. true 면 결제 검증 없이 구독이 열린다
ALLOW_UNVERIFIED_SUBSCRIBE=false

GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ── 텔레그램 Stars 결제 (claude/결제-시스템.md) ──
# setWebhook 의 secret_token 과 같은 값. 없으면 봇 웹훅을 전부 거절한다 (결제가 안 들어온다)
#   만들기: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# /refund <결제ID> 를 쓸 수 있는 텔레그램 유저 id (쉼표로 여러 명)
TELEGRAM_ADMIN_IDS=
# /paysupport 에 보여줄 연락처. 비우면 @Abror_bek_0 · abror0dev@gmail.com
TELEGRAM_SUPPORT_CONTACT=
# /start 의 "KORIO 열기" 버튼·인보이스 그림 주소. 기본 https://telegram.korio.online (빈 값이면 버튼 끔)
# TELEGRAM_MINI_APP_URL=https://telegram.korio.online

# ── Humo·Uzcard 카드 입금 (미니앱, 운영자 승인) ──
# ⚠️ 텔레그램 약관상 디지털 상품은 Stars 로만. 경고가 오면 false 로 바꾸고 deploy.sh → 즉시 사라진다
CARD_PAYMENT_ENABLED=false
# 돈 받을 카드. 카드끼리는 ; , 번호와 이름은 : (16자리 · 8600/9860 · Luhn 검사 — 틀리면 안 띄움)
#   예) CARD_PAYMENT_CARDS=9860 0000 0000 0000:ABRORBEK X;8600 0000 0000 0000:ABRORBEK X
CARD_PAYMENT_CARDS=
# 승인 요청은 TELEGRAM_ADMIN_IDS 의 모두에게 간다 (각자 봇에 /start 를 한 번 눌러 둬야 받는다)
# 진짜 맞는 번호인데 체크섬에서 막히면만: CARD_PAYMENT_SKIP_LUHN=true
# 영수증 OCR 모델 (OPENAI_API_KEY 를 같이 쓴다). 기본 gpt-4o-mini
# CARD_OCR_MODEL=gpt-4o-mini
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

GOOGLE_PLAY_PACKAGE_NAME=com.kai_dev.mobile
GOOGLE_SERVICE_ACCOUNT_JSON=
# Play Console > 보고서 다운로드 > 재무의 gs:// 버킷 URI 전체 (보고서가 생기면 사용).
GOOGLE_PLAY_REPORT_BUCKET=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_PUSH_SECRET=

# ── AI Voice Tutor 통화 (LiveKit) ──
# API 는 오디오를 지나보내지 않는다. 쿼터 → 프롬프트 → 참가자 토큰 →
# Agent dispatch 까지만 한다. 셋 중 하나라도 비면 튜터 통화가 비활성이다.
# ⚠️ deploy/agent.env 의 LIVEKIT_* 와 **같은 프로젝트**여야 한다.
LIVEKIT_URL=
LIVEKIT_API_KEY=
# 🔴 앱에는 절대 안 내려간다. 앱은 방 하나짜리 15분 토큰만 받는다
LIVEKIT_API_SECRET=
# ⚠️ agent.env 의 같은 값과 글자 하나까지 같아야 한다
VOICE_TUTOR_LIVEKIT_AGENT_NAME=korio-voice-tutor

# OpenAI: Voice Tutor 수업 에이전트(GPT)와 분석에 쓴다
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# AI 채팅(보리쌤)은 OpenAI 로 바뀌었다. 비우면 VOICE_TUTOR_LESSON_MODEL → gpt-4o-mini 순으로 쓴다.
# ANTHROPIC_* 는 이제 정답 채점(answer-grading)만 쓴다.
OPENAI_CHAT_MODEL=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=

# SIGTERM 후 새 요청을 끊고 기다리는 시간(ms). Caddy 의 health_interval(3s)보다
# 넉넉해야 프록시가 "내려간다"를 인지할 시간이 생긴다.
# docker-compose 의 stop_grace_period(30s) 보다는 짧아야 한다
SHUTDOWN_DRAIN_MS=8000

# ── 푸시 알림 (Expo Push) ──────────────────────────────────────────
# 선택 사항. Expo 계정에서 "enhanced security" 를 켠 경우에만 필요하다.
# 안 켰으면 비워둬도 푸시는 나간다.
# FCM 자격증명은 서버가 아니라 EAS 에 올린다: `eas credentials` → Android →
# FCM V1 service account. 서버는 서비스 계정 JSON 을 들고 있지 않는다.
EXPO_ACCESS_TOKEN=

# ── 비밀번호 재설정 메일 (Resend) ────────────────────────────────
# 없어도 서버는 뜬다. 다만 "비밀번호 찾기" 코드가 발송되지 않고 로그에만
# 찍힌다 (부팅 로그에 경고가 나온다).
#   1) resend.com 에서 korio.online 도메인을 인증하고 (SPF/DKIM DNS 3줄)
#   2) API 키를 만들어 여기에 넣는다
# 🔴 서버 전용 시크릿이다. 앱에는 절대 넣지 않는다.
RESEND_API_KEY=
# 발신자. 인증한 도메인이어야 한다
MAIL_FROM=KORIO <no-reply@korio.online>

# ── AI Voice Tutor ──────────────────────────────────────────────
# 선생님 목소리(ElevenLabs). 다시 듣기 MP3 를 API 가 만든다
ELEVENLABS_API_KEY=
# 위 OPENAI_API_KEY 와 ELEVENLABS_API_KEY 를 재사용한다.
# 실제 provider voice ID 는 서버의 deploy/api.env 에만 넣는다.
ELEVENLABS_DEFAULT_VOICE_ID=
# 여러 목소리를 제공할 경우 JSON 배열로 설정 (id, name, providerVoiceId, enabled).
# VOICE_TUTOR_VOICES_JSON=
VOICE_TUTOR_LESSON_MODEL=gpt-5.6-terra
VOICE_TUTOR_PROGRESS_MODEL=gpt-5.6-luna
VOICE_TUTOR_PLANNING_MODEL=gpt-5.6-terra
VOICE_TUTOR_STT_MODEL=gpt-transcribe
# 다시 듣기(MP3) 음성 모델: eleven_v4_turbo(기본) | eleven_v4 | eleven_v3. v2 계열은 거부된다.
# 워커(agent.env)의 VOICE_TUTOR_TTS_MODEL 과 맞춘다.
VOICE_TUTOR_TTS_MODEL=eleven_v4_turbo
# 수업 언어 on/off (ko = 한국어로만 가르치는 몰입 수업)
VOICE_TUTOR_EN_ENABLED=true
VOICE_TUTOR_RU_ENABLED=true
VOICE_TUTOR_UZ_ENABLED=true
VOICE_TUTOR_KO_ENABLED=true
# 사용 한도(분) — voice-tutor-quota.service.ts. 가장 비싼 기능이라 세션 발급 지점에서 막는다.
#   free : 평생 한 번 맛보기 10분 / super : 평생 한 번 맛보기 30분 / max : 매일 60분
# ⚠️ MAX 가 매일 60분을 다 쓰면 원가가 구독료를 넘는다. 손해를 막으려면 한 달 상한을 건다 (0 = 없음)
# VOICE_TUTOR_FREE_TRIAL_MINUTES=10
# VOICE_TUTOR_SUPER_TRIAL_MINUTES=30
# VOICE_TUTOR_MAX_DAILY_MINUTES=60
# VOICE_TUTOR_MAX_MONTHLY_MINUTES=300
