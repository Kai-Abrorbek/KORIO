# deploy/.env — 배포 호스트에만 두는 파일. git 에 올리지 않는다.
# cp .env.example .env 하고 채운다.

# API 가 서비스될 도메인. 이 도메인의 A 레코드가 이 서버를 가리켜야
# Let's Encrypt 인증서가 발급된다.
API_DOMAIN=api.korio.online

# 초대 링크가 열리는 도메인. 이 A 레코드도 이 서버를 가리켜야 한다.
# 여기에 /.well-known/assetlinks.json 이 서비스돼야 링크가 앱으로 곧장 열린다
WEB_DOMAIN=korio.online

# ACME(Let's Encrypt) 연락처 메일. **반드시 진짜 주소로 바꿔라.**
# example.com 을 두면 Let's Encrypt 가 invalidContact 로 거절하고,
# Caddy 가 조용히 대체 CA 로 넘어갔다가 인증서 없이 뜬다.
# 증상은 브라우저의 TLS internal error 라서 원인이 안 보인다.
ACME_EMAIL=abror0dev@gmail.com

# 이미지 이름 (기본 korio-api). 레지스트리를 쓰면 ghcr.io/kai/korio-api 처럼
IMAGE=korio-api

# 새 컨테이너가 healthy 가 될 때까지 기다리는 최대 초 (기본 120)
READY_TIMEOUT=120
