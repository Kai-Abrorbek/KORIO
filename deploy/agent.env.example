# deploy/agent.env — 배포 호스트에만 두는 파일. git 에 올리지 않는다.
#
#   cp agent.env.example agent.env && chmod 600 agent.env
#
# ⚠️ api.env 와 **분리된 파일이다.** GOOGLE_API_KEY 가 여기 있고, Gemini 에
#    붙는 건 Agent 뿐이라 API 컨테이너가 이 값을 알 이유가 없다.

# ── LiveKit ──
# api.env 의 LIVEKIT_* 와 **같은 프로젝트**를 가리켜야 한다. 다르면 API 가
# 만든 방에 Agent 가 영영 안 들어온다.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# explicit dispatch 이름.
# ⚠️ api.env 의 LIVEKIT_TUTOR_AGENT_NAME 과 **글자 하나까지** 같아야 한다.
#    다르면 dispatch 는 성공하고 아무도 방에 안 들어온다 — 앱은 연결된 채로
#    아무 소리도 안 나는, 제일 진단하기 어려운 실패가 된다.
LIVEKIT_TUTOR_AGENT_NAME=korio-tutor

# 새 AI Voice Tutor 전용 agentName. api.env 의 값과 같아야 한다.
VOICE_TUTOR_LIVEKIT_AGENT_NAME=korio-voice-tutor
# Worker가 호출할 API 기본 URL. 외부에서 접근 가능한 HTTPS 주소를 사용한다.
VOICE_TUTOR_API_URL=https://api.korio.online
# 새 Voice Tutor 전용 OpenAI STT / ElevenLabs TTS 키.
# api.env의 키는 Agent에 자동 전달되지 않으므로 여기에도 별도로 넣는다.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# 실시간 음성 모델: eleven_v4_turbo(기본, ~100ms) | eleven_v4 | eleven_v3.
# v4 Turbo 가 거절되면 워커가 알아서 eleven_v3 로 떨어진다 (로그에 남김).
VOICE_TUTOR_TTS_MODEL=eleven_v4_turbo
# 받아쓰기: 기본은 구간 받아쓰기 + gpt-transcribe. 실시간 WebSocket 은 VOICE_TUTOR_STT_REALTIME=true
VOICE_TUTOR_STT_MODEL=gpt-transcribe
# 받아쓰기 문맥(한국어 수업·섞이는 언어·선생님이 방금 한 말). 끄려면 false
# VOICE_TUTOR_STT_PROMPT=false
# 턴 넘김 대기(ms). 학습자가 말하다 자꾸 끊기면 올린다. 기본 600 / 2500
# VOICE_TUTOR_ENDPOINTING_MIN_MS=600
# VOICE_TUTOR_ENDPOINTING_MAX_MS=2500

# ── Gemini ──
# 🔴 서버 전용 시크릿. 앱에도 API 에도 넣지 않는다.
GOOGLE_API_KEY=

# metadata 에 모델이 안 실려 왔을 때의 마지막 보루.
# 평소에는 API 가 보낸 값을 쓴다 (api.env 의 GEMINI_LIVE_MODEL).
GEMINI_LIVE_MODEL=gemini-3.8-live
