# deploy/agent.env — 배포 호스트에만 두는 파일. git 에 올리지 않는다.
#
#   cp agent.env.example agent.env && chmod 600 agent.env
#
# ⚠️ api.env 와 **분리된 파일이다.** GOOGLE_API_KEY 가 여기 있고, Gemini 에
#    붙는 건 Agent 뿐이라 API 컨테이너가 이 값을 알 이유가 없다.

# ── LiveKit ──
# api.env 의 LIVEKIT_* 와 **같은 프로젝트**를 가리켜야 한다. 다르면 API 가
# 만든 방에 Agent 가 영영 안 들어온다.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# explicit dispatch 이름.
# ⚠️ api.env 의 LIVEKIT_TUTOR_AGENT_NAME 과 **글자 하나까지** 같아야 한다.
#    다르면 dispatch 는 성공하고 아무도 방에 안 들어온다 — 앱은 연결된 채로
#    아무 소리도 안 나는, 제일 진단하기 어려운 실패가 된다.
LIVEKIT_TUTOR_AGENT_NAME=korio-tutor

# ── Gemini ──
# 🔴 서버 전용 시크릿. 앱에도 API 에도 넣지 않는다.
GOOGLE_API_KEY=

# metadata 에 모델이 안 실려 왔을 때의 마지막 보루.
# 평소에는 API 가 보낸 값을 쓴다 (api.env 의 GEMINI_LIVE_MODEL).
GEMINI_LIVE_MODEL=gemini-3.8-live
